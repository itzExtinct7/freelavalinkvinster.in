{
  "version": 2,
  "functions": {
    "api/stats.js": {
      "maxDuration": 15
    },
    "api/search.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/player",
      "destination": "/player.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
